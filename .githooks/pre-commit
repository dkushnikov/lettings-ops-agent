#!/bin/sh
# Secret scan on staged changes. Enabled by `make setup` (core.hooksPath).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact || { echo "pre-commit: gitleaks found a secret in staged changes"; exit 1; }
else
  if git diff --cached | grep -E -q 'sk-ant-[A-Za-z0-9_-]{8,}|AKIA[0-9A-Z]{16}|xox[baprs]-'; then
    echo "pre-commit: something that looks like a credential is staged"; exit 1
  fi
fi
exit 0
