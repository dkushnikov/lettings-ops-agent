# Copy to .env (never committed). The harness reads these at start-up.
ANTHROPIC_API_KEY=
# Model used for the decision loop and the reviewer pass
LOA_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LOA_EFFORT=high
# Batch runner
LOA_CONCURRENCY=4
LOA_CASE_TIMEOUT_S=540
LOA_MAX_STEPS=12
LOA_RETRY_BUDGET=1
# Client-side throttle: estimated input tokens per minute the key may use
LOA_TPM_BUDGET=200000
# Optional: call-recording transcription
ELEVENLABS_API_KEY=
